<Window x:Class="League_Analyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:League_Analyser"
       
        xmlns:controls="clr-namespace:League_Analyser.View.UserControls"
        xmlns:screens="clr-namespace:League_Analyser.View.Screens"
        
        mc:Ignorable="d"
        Title="League Analyser" Height="900" Width="1325" WindowStyle="SingleBorderWindow" 
        ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="CanMinimize" 
        WindowStartupLocation="CenterScreen" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid x:Name="mainGrid">
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/Generic/mainTheme.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="83"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#BF000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image Source="/Resources/generic/appLogo.png" Width="83" Height="83" HorizontalAlignment="Left"/>
                <TextBlock Name="activeProfileName" Text="Username #Tag, Server" Foreground="White" FontSize="25" FontWeight="Medium"
                 VerticalAlignment="Center" Margin="90,0,0,0" Visibility="Hidden"/>
            </Grid>

            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Name="button_update" Style="{StaticResource ButtonHoverInvertStyle}" 
                        HorizontalAlignment="Right" Width="75" Height="75" d:IsHidden="False" Visibility="Hidden" Margin="0,0,3,0">
                        <Button.Foreground>
                            <ImageBrush ImageSource="/Resources/Generic/update_icon_active.png"/>
                        </Button.Foreground>
                        <Button.Background>
                            <ImageBrush ImageSource="/Resources/Generic/update_icon_inactive.png"/>
                        </Button.Background>
                    </Button>
                    <controls:MenuButtons x:Name="menuButtons"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="appVersion" Text="Wersja aplikacji:        -" Foreground="Gray"/>
                    <TextBlock Name="dataVersion" Text="Wersja danych:         -" Foreground="Gray"/>
                    <TextBlock Name="patchVersion" Text="Patch (DataDragon): -" Foreground="Gray"/>
                    <TextBlock Text="©Mvcias 2025" Foreground="Gray" Margin="0,15,0,0" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">

        </Grid>
    </Grid>
</Window>

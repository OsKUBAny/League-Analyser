<UserControl x:Name="matchHistory" x:Class="League_Analyser.View.Screens.MatchHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.Screens"
             xmlns:controls="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="778" Width="1310" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid Name="localGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Rectangle Fill="#7F000000" HorizontalAlignment="Left" VerticalAlignment="Top" Width="330" Height="778" 
                       Margin="0,0,0,0" Panel.ZIndex="-1"/>
            <TextBlock Name="visibleMatchesCount" Foreground="White" Text="(888 - 888) - 888" FontSize="18" 
                       Margin="0,4,22,0" HorizontalAlignment="Right"/>

            <ScrollViewer Background="#00000000" Width="320" Height="740"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,30,0,0"
                      VerticalScrollBarVisibility="Visible" FlowDirection="LeftToRight"
                      ScrollChanged="UpdateVisibleMatchesValue">

                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid>
                                        <Rectangle Fill="#00000000"/>
                                        <Track Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Background="White"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Name="matchList" Orientation="Vertical">
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1" Name="gridStatistics">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,980,778" />
            </Grid.Clip>
        </Grid>
        
    </Grid>
</UserControl>

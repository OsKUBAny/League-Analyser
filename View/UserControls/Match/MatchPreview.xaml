<UserControl x:Name="matchPreview" x:Class="League_Analyser.View.UserControls.MatchPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="90" Width="300" Margin="0,2,0,0" Background="#FF575757">
    <Grid>
        <Image Name="champion" Width="90" Height="90" HorizontalAlignment="Left"/>
        <TextBlock Name="mapName" Text="Summoner's Rift" Margin="95,0,0,0" FontSize="18" FontWeight="Medium" Foreground="White"/>
        <TextBlock Name="gameType" Text="Ranked game" Margin="95,20,0,0" FontSize="12" FontWeight="Normal" Foreground="White"/>
        <TextBlock Name="date" Text="88.88.8888, 88:88" Margin="95,35,0,0" FontSize="15" FontWeight="Light" Foreground="White"/>
        <TextBlock Name="kda" Text="888/888/888" Margin="95,0,0,5" VerticalAlignment="Bottom" FontSize="25" FontWeight="Bold" 
                   Foreground="White"/>
        <Rectangle Name="result" HorizontalAlignment="Right" Width="30"/>
        <Rectangle Name="selected" Stroke="#FFFFC500" StrokeThickness="5" Visibility="Hidden" Fill="#26FFC500"/>
    </Grid>
</UserControl>

<UserControl x:Name="playerStatistics" x:Class="League_Analyser.View.UserControls.PlayerStatistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="58" Width="640" Margin="0,2,0,0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="valueLeft" Text="000,000" Foreground="White" FontSize="15" Grid.Column="0"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="SemiBold"/>

        <TextBlock Name="valueRight" Text="000,000" Foreground="White" FontSize="15" Grid.Column="2" 
                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" FontWeight="SemiBold"/>

        <Rectangle Name="barLeft" Fill="LightGray" Grid.Column="1" Margin="0,15,0,15" HorizontalAlignment="Left" Width="100"/>

        <Rectangle Name="barRight" Fill="LightGray" Grid.Column="1" Margin="0,15,0,15" HorizontalAlignment="Right" Width="100"/>

        <TextBlock Name="statusText" Text="ZDOBYWCA" Foreground="#FF67E200" FontSize="15" Grid.Column="1"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="00,0,0,0" FontWeight="Bold"/>

        <Rectangle Name="statusIndicator" Grid.ColumnSpan="2" Margin="0,0,0,0" HorizontalAlignment="Left"
                   Panel.ZIndex="-1" Width="300" Height="40" Fill="DarkGreen">
        </Rectangle>
    </Grid>
</UserControl>

<UserControl x:Name="matchPlayer" x:Class="League_Analyser.View.UserControls.MatchPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="58" Width="320" Margin="0,1,0,1" Background="#7F000000">
    <Grid>
        <Image Name="championImg" Width="58" Height="58" HorizontalAlignment="Left" Stretch="UniformToFill" Source="/Resources/empty.png"/>
        <TextBlock Name="championName" Text="Champion Name" FontSize="15" FontWeight="Medium" Foreground="White" Margin="82,12,0,0"/>
        <TextBlock Name="playerName" Text="Player Name" FontSize="10" FontWeight="Normal" Foreground="White" Margin="60,00,0,0"/>
        
        <Ellipse Width="18" Height="18" Stroke="#FFF7D45D" StrokeThickness="1.5" Margin="0,0,180,12" Fill="#FFF7D45D"/>
        <TextBlock Name="championLevel" Text="88" HorizontalAlignment="Center" Margin="0,14.6,180.1,0" 
                   FontSize="12" FontWeight="bold" Foreground="Black"/>

        <TextBlock Name="kda" Text="88/88/88" HorizontalAlignment="Right" FontSize="20" FontWeight="bold" Foreground="White" 
                   Margin="0,0,2,0"/>

        <Image Source="/Resources/MatchRelated/goldIcon.png" Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Right" 
               Margin="0,26,2,0"/>
        <TextBlock Name="gold" Text="888,888" HorizontalAlignment="Right" FontSize="10" FontWeight="Normal" Foreground="Gold" 
                   Margin="0,24,15,0"/>

        <Image Source="/Resources/MatchRelated/minionIcon.png" Width="15" Height="15" VerticalAlignment="Top" HorizontalAlignment="Right" 
               Margin="0,24,55,0" Stretch="Uniform"/>
        <TextBlock Name="minions" Text="888" HorizontalAlignment="Right" FontSize="10" FontWeight="Normal" Foreground="White" 
                   Margin="0,24,70,0"/>

        <StackPanel Name="itemsStackPanel" Orientation="Horizontal" HorizontalAlignment="Left" Margin="60,35,0,0"/>
        
        <Image Name="spellD" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Stretch="UniformToFill" Source="/Resources/empty.png" Margin="0,0,24,0"/>
        <Image Name="spellF" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Stretch="UniformToFill" Source="/Resources/empty.png" Margin="0,0,2,0"/>

    </Grid>
</UserControl>

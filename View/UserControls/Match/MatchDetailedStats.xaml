<UserControl x:Class="League_Analyser.View.UserControls.MatchDetailedStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="663" Width="640" Background="#3F000000" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,15">
    
    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#80000000"/>
            <!-- Półprzezroczyste czarne tło -->
            <Setter Property="Foreground" Value="White"/>
            <!-- Białe napisy -->
            <Setter Property="BorderBrush" Value="Black"/>
            <!-- Szary border -->
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="curtain" 
                             Storyboard.TargetProperty="Width"
                             From="0" To="640" Duration="0:0:0.100"/>
            </Storyboard>
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetName="curtain" 
                             Storyboard.TargetProperty="Width"
                             From="640" To="0" Duration="0:0:0.100"/>
        </Storyboard>
    </UserControl.Resources>
    
    
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <ComboBox Name="comboBox_category" Width="200" Height="30" IsReadOnly="True" Margin="0,0,0,0" 
                      FontSize="15" FontWeight="SemiBold" Foreground="#FF292929"/>
            <ComboBox Name="comboBox_type" Width="370" Height="30" IsReadOnly="True" Margin="10,0,0,0"
                      FontSize="15" FontWeight="Normal" Foreground="#FF292929"/>
        </StackPanel>

        <StackPanel Name="allayTeam" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,30,0,0"/>
        <StackPanel Name="enemyTeam" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,365,0,0"/>

        <Grid Name="scaleInfo">
            <TextBlock Text="|" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="64,20,64,0"/>
            <TextBlock Text="|" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="166.4,20,64,0"/>
            <TextBlock Text="|" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="268.8,20,64,0"/>
            <TextBlock Text="|" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="371.2,20,64,0"/>
            <TextBlock Text="|" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="473.6,20,64,0"/>
            <TextBlock Text="|" HorizontalAlignment="Right" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="64,20,64,0"/>


            <TextBlock Text="0%" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="59,55,64,0"/>
            <TextBlock Text="20%" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="158,55,64,0"/>
            <TextBlock Text="40%" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="261,55,64,0"/>
            <TextBlock Text="60%" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="363,55,64,0"/>
            <TextBlock Text="80%" HorizontalAlignment="Left" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="465,55,64,0"/>
            <TextBlock Text="100%" HorizontalAlignment="Right" Foreground="LightGray" VerticalAlignment="Center" FontSize="10" Margin="55,55,53,0"/>
        </Grid>

        <Rectangle Name="curtain" Fill="#FFC5C5C5" Margin="0,35,0,0" Width="0" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </Grid>
</UserControl>

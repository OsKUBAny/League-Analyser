<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             xmlns:global="clr-namespace:League_Analyser"
             xmlns:DocumentStructures="clr-namespace:System.Windows.Documents.DocumentStructures;assembly=PresentationFramework" 
             x:Class="League_Analyser.View.UserControls.SettingsNewProfile"
             mc:Ignorable="d" 
             Width="450" Height="200" Background="#7F000000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="25*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0">
            <Run Text="{x:Static global:Messages.settings_newPlayer_name}"/>
            <Run Text=":"/>
        </TextBlock>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0">
        <Run Text="{x:Static global:Messages.settings_newPlayer_tag}"/>
        <Run Text=":"/>
        </TextBlock>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0">
        <Run Text="{x:Static global:Messages.settings_newPlayer_server}"/>
        <Run Text=":"/>
        </TextBlock>

        <TextBox Grid.Row="0" Grid.Column="1" x:Name="textBox_name" Width="250" Height="30"
                 VerticalContentAlignment="Center" HorizontalAlignment="Center" FontSize="15"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="textBox_tag" Width="250" Height="30" 
                 VerticalContentAlignment="Center" HorizontalAlignment="Center" FontSize="15"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="comboBox_server" Width="250" Height="30" 
                 VerticalContentAlignment="Center" HorizontalAlignment="Center" FontSize="15">
        </ComboBox>

        <Button Grid.Row="3" Grid.Column="0" x:Name="button_Cancel" Style="{StaticResource ButtonHoverInvertStyle}" 
                Background="#FFF00A0A" Foreground="#FF811010" Content="{x:Static global:Messages.settings_newPlayer_button_cancel}" 
                FontSize="15" Width="150" Height="30" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom"/>
        <Button Grid.Row="3" Grid.Column="1" x:Name="button_Add" Style="{StaticResource ButtonHoverInvertStyle}" 
                Background="#FF14F00A" Foreground="#FF1A6609" Content="{x:Static global:Messages.settings_newPlayer_button_add}" 
                FontSize="15" Width="150" Height="30" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom"/>

    </Grid>
</UserControl>

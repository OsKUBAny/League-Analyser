<UserControl x:Class="League_Analyser.View.UserControls.SettingsProfileDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="800" Width="450" HorizontalAlignment="Right">
    
    <UserControl.Resources>
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="localGrid" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="450" To="0" Duration="0:0:0.200"/>
        </Storyboard>

        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetName="localGrid" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="450" Duration="0:0:0.200"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Name="localGrid" Background="#7F000000">

        <Grid.RenderTransform>
            <TranslateTransform x:Name="Transform" X="450"/>
        </Grid.RenderTransform>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="profileName" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="OsKUBAny" Foreground="White" FontSize="25" Margin="10,10,0,0"/>
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Wersja pliku danych:" Foreground="White" FontSize="18" 
                   Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="0" Grid.Row="2" Text="Liczba zapisanych rozgrywek:" Foreground="White" FontSize="18" 
                   Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="0" Grid.Row="3" Text="Ostatnia rozgrywka:" Foreground="White" FontSize="18" 
                   Margin="10,0,0,0" VerticalAlignment="Center"/>

        <TextBlock Name="dataVersion" Grid.Column="1" Grid.Row="1" Text="1.0" Foreground="White" FontSize="18" 
                   VerticalAlignment="Center"/>
        <TextBlock Name="numberOfMatches" Grid.Column="1" Grid.Row="2" Text="0" Foreground="White" FontSize="18" 
                   VerticalAlignment="Center"/>
        <TextBlock Name="lastGameDate" Grid.Column="1" Grid.Row="3" Text="88.88.8888, 88:88" Foreground="White" FontSize="15" 
                   VerticalAlignment="Center"/>

        <Button Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Name="button_delete" Style="{StaticResource ButtonHoverInvertStyle}" 
                Content="Usuń profil" FontSize="15" Height="30" Width="140" Background="Red" Foreground="#FFFFD4D4" 
                HorizontalAlignment="Left" Margin="75,0,0,0" />
        <Button Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Name="button_downloadAll" Style="{StaticResource ButtonHoverInvertStyle}" 
                Content="Pobierz od zera" FontSize="15" Height="30" Width="140" Background="#FF26D300" Foreground="#FFE0FFD4" 
                HorizontalAlignment="Right" Margin="0,0,75,0" />
        <Button Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Name="button_loadProfile" Style="{StaticResource ButtonHoverInvertStyle}" 
                Content="Ustaw jako aktywny" FontSize="15" Height="30" Width="300" Background="#FF00ADD3" Foreground="#FFD4F7FF" 
                HorizontalAlignment="Center" Margin="0,0,0,0" />

        <TextBlock Name="outdatedDataVersionText" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" 
                   Text="Wersja pliku danych nie jest najnowsza. Należy usunąć profil i stworzyć go ponownie." 
                   Foreground="Red" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
        
    </Grid>
</UserControl>

<UserControl x:Name="spellPopup" x:Class="League_Analyser.View.UserControls.SpellPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="135" Width="250" Background="#E5232D37" HorizontalAlignment="Left" VerticalAlignment="Top" 
             BorderBrush="#FFD1D1D1" BorderThickness="1,1,1,1">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="spellPopup" 
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.200"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Name="localGrid">
        <Image Name="image" Width="60" Height="60" Source="/Resources/empty.png" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Width="60" Height="60" Stroke="White" StrokeThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        
        <TextBlock Name="skillTypeName" Text="Champion - Q" Foreground="White" FontSize="12" FontWeight="Bold"
                   Margin="65,0,0,0"/>
        <TextBlock Name="skillName" Text="Skill's name" Foreground="White" FontSize="10" FontWeight="Normal"
                   Margin="65,15,0,0" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                   TextWrapping="WrapWithOverflow"/>
        <TextBlock Name="skillDescription" Text="Description" Foreground="White" FontSize="8" FontWeight="Normal"
           Margin="65,30,0,0" Height="35" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="WrapWithOverflow"/>

        <TextBlock Text="Obrażenia:" Foreground="White" FontSize="12" FontWeight="Bold"
           Margin="2,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <TextBlock Text="Całkowite:" Foreground="LightGray" FontSize="10" FontWeight="Normal"
           Margin="2,75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Fizyczne:" Foreground="Red" FontSize="10" FontWeight="Normal"
           Margin="2,92,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Magiczne:" Foreground="LightBlue" FontSize="10" FontWeight="Normal"
           Margin="2,104,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="True:" Foreground="White" FontSize="10" FontWeight="Normal"
           Margin="2,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Name="damageTotal" Text="88,888" Foreground="LightGray" FontSize="10" FontWeight="Normal"
   Margin="0,75,160,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <TextBlock Name="damagePhysical" Text="88,888" Foreground="Red" FontSize="10" FontWeight="Normal"
   Margin="0,92,160,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <TextBlock Name="damageMagic" Text="88,888" Foreground="LightBlue" FontSize="10" FontWeight="Normal"
   Margin="0,104,160,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <TextBlock Name="damageTrue" Text="88,888" Foreground="White" FontSize="10" FontWeight="Normal"
   Margin="0,116,160,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>

    </Grid>
</UserControl>

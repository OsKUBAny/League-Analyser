<UserControl x:Class="League_Analyser.View.UserControls.ScrollBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="15" Width="568" Background="Transparent">
    <Grid Name="localGrid">
        <Rectangle Name="Thumb" Fill="White" Height="15" HorizontalAlignment="Left" Width="50"
                   MouseLeftButtonDown="Thumb_MouseLeftButtonDown"
                   MouseMove="Thumb_MouseMove"
                   MouseLeftButtonUp="Thumb_MouseLeftButtonUp"
                   LostMouseCapture="Thumb_LostMouseCapture">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#FFD4D4D4"/>
            </Rectangle.Stroke>
        </Rectangle>
    </Grid>
</UserControl>

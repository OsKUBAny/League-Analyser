<UserControl x:Class="League_Analyser.View.UserControls.TimelineAxis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:League_Analyser.View.UserControls"
             mc:Ignorable="d" 
             Height="125" Width="640">
    <Grid MouseWheel="Scroll_MouseWheel" Background="#00000000">
        <Grid Name="timestamps" VerticalAlignment="Bottom" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>
            
            <TextBlock Name="ts_1" Text="00:00" Foreground="White" HorizontalAlignment="Left" TextAlignment="Center" Margin="5,0,0,0" Grid.Row="1"/>
            <TextBlock Name="ts_2" Text="00:00" Foreground="White" HorizontalAlignment="Left" TextAlignment="Center" Margin="145.25,0,0,0" Grid.Row="1"/>
            <TextBlock Name="ts_3" Text="00:00" Foreground="White" HorizontalAlignment="Left" TextAlignment="Center" Margin="290.5,0,0,0" Grid.Row="1"/>
            <TextBlock Name="ts_4" Text="00:00" Foreground="White" HorizontalAlignment="Left" TextAlignment="Center" Margin="435.75,0,0,0" Grid.Row="1"/>
            <TextBlock Name="ts_5" Text="00:00" Foreground="White" HorizontalAlignment="Right" TextAlignment="Center" Margin="0,0,40,0" Grid.Row="1"/>

            <TextBlock Text="|" Foreground="White" HorizontalAlignment="Left" Margin="18,0,0,0" Grid.Row="0"/>
            <TextBlock Text="|" Foreground="White" HorizontalAlignment="Left" Margin="158,0,0,0" Grid.Row="0"/>
            <TextBlock Text="|" Foreground="White" HorizontalAlignment="Left" Margin="303,0,0,0" Grid.Row="0"/>
            <TextBlock Text="|" Foreground="White" HorizontalAlignment="Left" Margin="448.5,0,0,0" Grid.Row="0"/>
            <TextBlock Text="|" Foreground="White" HorizontalAlignment="Right" Margin="0,0,52,0" Grid.Row="0"/>
        </Grid>

        <Border BorderBrush="White" BorderThickness="1" Padding="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Name="button_zoomIn" Width="23" Height="23" Text="+" FontWeight="Black" FontSize="15" Margin="0,0,0,25"
                   Background="#00AAAAAA" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   MouseLeftButtonUp="AxisZoomChanged" Foreground="White"/>
        </Border>
        <Border BorderBrush="White" BorderThickness="1" Padding="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Name="button_zoomOut" Width="23" Height="23" Text="-" FontWeight="Black" FontSize="15"
                   Background="#00AAAAAA" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   MouseLeftButtonUp="AxisZoomChanged" Foreground="White"/>
        </Border>

        <local:ScrollBar x:Name="scrollBar" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="19,0,0,0"/>

        <StackPanel Name="eventsContainer" Orientation="Vertical" Width="568" Height="60" 
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="19,0,0,38">
        <Canvas Name="eventsContainer_buildings" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="568" Height="20"/>
        <Canvas Name="eventsContainer_monsters" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="568" Height="20"/>
        <Canvas Name="eventsContainer_kills" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="568" Height="20"/>
        </StackPanel>

        <local:ComboListBox x:Name="comboList_players" VerticalAlignment="Top" HorizontalAlignment="Left" 
                    Margin="19,0,0,-10" ClipToBounds="False"/>


    </Grid>
</UserControl>
